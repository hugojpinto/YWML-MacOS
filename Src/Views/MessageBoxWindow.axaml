<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="YWML.Src.Views.MessageBoxWindow"
        Title="YWML"
        Width="460"
        SizeToContent="Height"
        MinHeight="130"
        MaxWidth="640"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="18">
        <ScrollViewer Grid.Row="0" MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
            <SelectableTextBlock x:Name="MessageText"
                                 TextWrapping="Wrap"
                                 FontSize="13" />
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,18,0,0">
            <Button x:Name="YesButton" Content="Yes" MinWidth="80" IsVisible="False" Click="YesButton_Click" />
            <Button x:Name="NoButton" Content="No" MinWidth="80" IsVisible="False" Click="NoButton_Click" IsCancel="True" />
            <Button x:Name="OkButton" Content="OK" MinWidth="80" Click="OkButton_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
